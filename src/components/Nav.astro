---
import { SITE } from '../data/site';
---

<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="/">{SITE.shortName}</a>
    <nav aria-label="Main">
      <a href="/#work">Work</a>
      <a href="/#approach">Approach</a>
      <a href="/#about">About</a>
      <a class="cv" href={SITE.contact.cv}>CV</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgb(252 252 253 / 0.88);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.75rem;
  }
  .brand {
    font-weight: 750;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 1.25rem;
    font-size: 0.92rem;
  }
  nav a {
    text-decoration: none;
    color: var(--ink-soft);
  }
  nav a:hover {
    color: var(--ink);
  }
  nav .cv {
    color: var(--accent);
    font-weight: 600;
  }
  @media (max-width: 420px) {
    nav a:not(.cv):nth-child(2) {
      display: none;
    }
  }
</style>
