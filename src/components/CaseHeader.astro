---
interface Props {
  title: string;
  summary: string;
  status: string;
  role: string;
  clientType: string;
  figures: { value: string; label: string }[];
}

const { title, summary, status, role, clientType, figures } = Astro.props;
---

<header class="wrap head">
  <div class="chips">
    <span class="chip status" data-testid="case-status">{status}</span>
    <span class="chip">{role}</span>
    <span class="chip">{clientType}</span>
  </div>
  <h1>{title}</h1>
  <p class="summary">{summary}</p>
  <ul class="figures">
    {
      figures.map((f) => (
        <li data-testid="case-figure">
          <div class="figure-value">{f.value}</div>
          <div class="figure-label">{f.label}</div>
        </li>
      ))
    }
  </ul>
</header>

<style>
  .head {
    padding-top: 3rem;
    padding-bottom: 2.5rem;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chip {
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink-soft);
  }
  .status {
    background: #e8eeff;
    color: var(--accent-ink);
  }
  h1 {
    margin-top: 1.25rem;
    font-size: clamp(2.1rem, 6vw, 3.6rem);
    letter-spacing: -0.04em;
    max-width: 20ch;
  }
  .summary {
    margin: 1.1rem 0 0;
    font-size: 1.15rem;
    color: var(--ink-soft);
    max-width: 58ch;
  }
  .figures {
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    max-width: 48rem;
  }
</style>
